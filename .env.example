# All settings are optional. Copy to .env only if you want defaults;
# the agent can pass zip_code to every tool instead.

# Default ZIP so tools don't need the argument each time.
# GROCERY_ZIP=12345

# Restrict to stores you'd actually drive to. Empty = every grocery
# circular in that ZIP.
# GROCERY_STORES=Aldi,Lidl,Costco

# How long the local deal index stays fresh before an auto-rebuild.
# GROCERY_CACHE_TTL_HOURS=12

# Where the cache and price history are stored.
# GROCERY_DB_PATH=./data/deals.db

# Optional: exact Kroger-banner pricing. Free app registration at
# https://developer.kroger.com
# KROGER_CLIENT_ID=
# KROGER_CLIENT_SECRET=
# KROGER_LOCATION_ID=
